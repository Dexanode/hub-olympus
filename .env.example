# Copy this file to .env and fill one key. Never commit .env.
# If both keys are set, OpenAI is used unless LLM_PROVIDER picks one.
# LLM_PROVIDER=openai
# LLM_PROVIDER=deepseek
# LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# PORT=8787
# CHAT_TIMEOUT_MS=25000
# CHAT_RATE_LIMIT=20
# CHAT_RATE_WINDOW_MS=60000
# MOCK_STREAM_DELAY_MS=40
