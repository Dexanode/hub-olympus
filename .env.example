# Copy this file to .env and fill one key. Never commit .env.
# If both keys are set, OpenAI is used unless LLM_PROVIDER picks one.
# LLM_PROVIDER=openai
# LLM_PROVIDER=deepseek
# LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# PORT=8787
# CHAT_TIMEOUT_MS=25000
# CHAT_RATE_LIMIT=20
# CHAT_RATE_WINDOW_MS=60000
# MOCK_STREAM_DELAY_MS=40

# Hades reads public RPCs only. Override a URL when a default endpoint is blocked.
# ETH_RPC_URL=https://ethereum.publicnode.com
# BASE_RPC_URL=https://mainnet.base.org
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# POLYGON_RPC_URL=https://polygon-rpc.com
# CHAIN_RPC_TIMEOUT_MS=8000
# CHAIN_RATE_LIMIT=30
# CHAIN_RATE_WINDOW_MS=60000

# Optional. Recent transaction history needs this key. Hades still answers RPC lookups without it.
# ETHERSCAN_API_KEY=
